# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env git'e eklenmez.

# Copernicus Climate Data Store (ERA5) — https://cds.climate.copernicus.eu/how-to-api
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=

# EPİAŞ Şeffaflık Platformu — https://seffaflik.epias.com.tr
EPIAS_USERNAME=
EPIAS_PASSWORD=

# Yayın (src/v4_yayin.py) — yalnız yayın adımında gerekir
# GitHub fine-grained token: yalnız bu repo, "Contents: Read and write"
GITHUB_TOKEN=
# Hugging Face "Write" token (veri deposu + Space)
HF_TOKEN=
